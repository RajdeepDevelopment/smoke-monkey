POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_secret
POSTGRES_DB=ragdb

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMS=768

# Chat LLM provider: "ollama" | "openrouter" | "nvidia" | "gemini"
LLM_PROVIDER=ollama

# OpenRouter (cloud)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_CHAT_MODELS=nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-super-120b-a12b:free,deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,z-ai/glm-5.2

# NVIDIA NIM (cloud)
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_CHAT_MODELS=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMS=2048
NVIDIA_RERANK_ENABLED=false
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

EMBED_PROVIDER=openrouter
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBED_DIMS=2048
OPENROUTER_RERANK_ENABLED=true
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

HYDE_ENABLED=true
MULTI_QUERY_ENABLED=true
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CACHE_ENABLED=true
QUERY_CACHE_TTL=300
TOP_K=12
RERANK_TOP_N=8
CONTEXT_TOKEN_BUDGET=6000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
HALLUCINATION_CHECK_ENABLED=false

# Agentic query routing + super memory (see root .env.example)
ROUTER_ENABLED=true
ROUTER_CACHE_TTL=300
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.12
MEMORY_EXTRACT_ENABLED=true
# Only facts scored at least this importance (0.0-1.0) are stored.
MEMORY_EXTRACT_MIN_IMPORTANCE=0.5
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TOP_K=5
# Multi-provider live search: user keys always win over these server defaults.
# TAVILY_SEARCH_DEPTH=basic (1 credit) keeps the free tier (~1k searches/mo) alive.
WEB_SEARCH_CACHE_TTL=21600
WEB_SEARCH_PROVIDERS=tavily,google,brave,bing,duckduckgo
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BRAVE_API_KEY=
BING_API_KEY=
